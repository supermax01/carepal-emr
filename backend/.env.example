# OpenEMR Configuration
OPENEMR_BASE_URL=https://your-openemr-site
OPENEMR_SITE_ID=default
OPENEMR_CLIENT_ID=your_client_id
OPENEMR_CLIENT_SECRET=your_client_secret
OPENEMR_REDIRECT_URI=http://localhost:8000/api/oauth/callback

# FastAPI Settings
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# App Settings
FLUTTER_APP_REDIRECT_SCHEME=carepalemr

# NGROK Configuration (needed for HTTPS)
NGROK_AUTH_TOKEN=your_ngrok_auth_token 